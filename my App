# ---------------- Season Helpers ----------------
def month_to_season_phase(m): return ("planting", "planting season") if m in (11,12,1) else ("growing", "growing season") if m in (2,3) else ("harvest", "harvest season") if m in (4,5,6) else ("storage", "storage season")
def season_risk_notes(p): return "Risk: oversupply -> prices fall" if p=="harvest" else "Risk: weather affects yield" if p=="growing" else "Risk: storage pests"

# ---------------- Data Loader ----------------
def find_prices_for(product: str, district: str) -> Optional[List[float]]:
    single_price = _price_from_csv(product, district)
    if single_price is not None:
        return [single_price] * HISTORICAL_DAYS
    hist = HISTORICAL_PRICES.get(product)
    prices = hist.get(district, hist.get("Default")) if isinstance(hist, dict) else hist
    return prices[-HISTORICAL_DAYS:] if prices else [800] * HISTORICAL_DAYS

# ---------------- Advice ----------------
async def generate_advice_async(product_full, district, days, trend, base_price, last_pred_price):
    phase, expl = month_to_season_phase(datetime.datetime.now().month)
    note = season_risk_notes(phase)
    tips = {
        "increase": [f"• Prices rising — store now. ({phase.capitalize()}: {expl})", "• Prevent losses in storage.", f"• Time sales for peak. {note}"],
        "decrease": ["• Prices falling — sell soon.", "• Find nearby buyers.", f"• Reduce storage costs. {note}"],
        "stable": ["• Prices stable — sell as needed.", "• Compare buyer offers.", f"• Keep small reserve. {note}"]
    }
    return tips.get(trend, tips["stable"])

