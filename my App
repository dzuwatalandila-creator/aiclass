# ---------------- CSV Cache ----------------
_cached_csv_df: Optional[pd.DataFrame] = None

def _load_csv_fallback() -> pd.DataFrame:
    global _cached_csv_df
    if _cached_csv_df is not None:
        return _cached_csv_df
    try:
        logger.info("Downloading fallback CSV from GitHub...")
        resp = requests.get(CSV_FALLBACK_URL, timeout=12)
        resp.raise_for_status()
        _cached_csv_df = pd.read_csv(io.StringIO(resp.text))
        logger.info(f"CSV loaded: {_cached_csv_df.shape[0]} rows")
        return _cached_csv_df
    except Exception as exc:
        logger.error(f"Failed to load CSV fallback: {exc}")
        raise

def _price_from_csv(product: str, district: str) -> Optional[float]:
    try:
        df = _load_csv_fallback()
        df.columns = [c.strip().lower() for c in df.columns]
        commodity_col = next((c for c in df.columns if 'commodity' in c), None)
        district_col = next((c for c in df.columns if 'district' in c), None)
        price_col = next((c for c in df.columns if any(k in c for k in ['price', 'mwk', 'value', 'median', 'retail'])), None)
        if not all([commodity_col, district_col, price_col]):
            return None
        df[commodity_col] = df[commodity_col].astype(str).str.strip().str.title()
        df[district_col] = df[district_col].astype(str).str.strip().str.title()
        mask = df[commodity_col].str.contains(product, case=False, na=False) & df[district_col].str.contains(district, case=False, na=False)
        row = df[mask]
        if row.empty:
            return None
        return float(row[price_col].iloc[0])
    except:
        return None

