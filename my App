    def update_subtype(self, spinner, text):
        self.subtype_spinner.values = PRODUCT_SUBTYPES.get(text, [])
        self.subtype_spinner.text = self.subtype_spinner.values[0] if self.subtype_spinner.values else "No subtype"

    def force_refresh_live(self):
        self.live_status.text = "[color=ffaa00]Loading...[/color]"
        Clock.schedule_once(lambda dt: asyncio.run(self.async_predict_price(force_refresh=True)), 0.1)

    def start_prediction(self, _):
        self.predict_button.disabled = True
        self.result_label.text = "Predicting..."
        self.popup = Popup(title="Working...", size_hint=(0.4, 0.25), content=ProgressBar())
        self.popup.open()
        Clock.schedule_once(lambda dt: asyncio.run(self.async_predict_price()), 0)

    async def async_predict_price(self, force_refresh=False):
        district = self.district_spinner.text
        product = self.product_spinner.text
        subtype = self.subtype_spinner.text if self.subtype_spinner.text not in ("Select Subtype", "No subtype") else ""
        product_full = f"{product} ({subtype})" if subtype else product
        try:
            days = int(self.days_input.text)
            if not 1 <= days <= 60: raise ValueError
        except:
            self.update_ui("Enter days 1–60.")
            self.close_popup()
            return

        live_prices = find_prices_for(product, district)
        historical_prices = live_prices[-HISTORICAL_DAYS:] if live_prices else HISTORICAL_PRICES.get(product, [800]*7)
        if len(historical_prices) < HISTORICAL_DAYS:
            historical_prices = [historical_prices[0]] * (HISTORICAL_DAYS - len(historical_prices)) + historical_prices

        base_price = historical_prices[-1]
        y_pred = base_price + np.cumsum(np.random.randint(-20, 50, size=days))
        if product == "Maize": y_pred = np.clip(y_pred, 800, 1500)
        last_pred_price = float(y_pred[-1])
        trend = "increase" if last_pred_price > base_price else "decrease" if last_pred_price < base_price else "stable"
        advice = await generate_advice_async(product_full, district, days, trend, base_price, last_pred_price)

        entry = {"timestamp": datetime.datetime.utcnow().isoformat() + "Z", "product": product_full, "district": district, "days": days, "historical_prices": historical_prices, "predicted_prices": y_pred.tolist(), "trend": trend, "advice_bullets": advice}
        add_history_entry(entry); self.render_history()
        self.update_ui_with_plot(historical_prices, y_pred, HISTORICAL_DAYS, days, product_full, district, product, advice, source_note=" (CSV)" if live_prices else " (sample)")

    @mainthread
    def render_history(self):
        self.history_grid.clear_widgets()
        for item in reversed(load_history()):
            btn = Button(text=f"{item['timestamp'][:19].replace('T',' ')} • {item['product']} • {item['trend'].upper()} • {item['predicted_prices'][-1]:.0f} MWK", size_hint_y=None, height=44, halign='left')
            btn.bind(on_press=lambda b, e=item: asyncio.run(self.reopen(e)))
            self.history_grid.add_widget(btn)

    async def reopen(self, entry):
        self.update_ui_with_plot(entry["historical_prices"], np.array(entry["predicted_prices"]), HISTORICAL_DAYS, entry["days"], entry["product"], entry["district"], entry["product"].split()[0], entry["advice_bullets"])

    @mainthread
    def update_ui_with_plot(self, hist, pred, hdays, days, prod_full, dist, prod, advice, source_note=""):
        self.plot_box.clear_widgets()
        fig, ax = plt.subplots(figsize=(8, 3.5))
        all_x = list(range(1, hdays + days + 1))
        ax.plot(all_x[:hdays], hist, 'o-', label='Past')
        ax.plot(all_x[hdays-1:], np.concatenate([hist[-1:], pred]), 'o--', label='Future')
        ax.set_title(f"{prod_full} in {dist}{source_note}")
        ax.set_xlabel("Day"); ax.set_ylabel("Price (MWK/kg)"); ax.grid(); ax.legend()
        self.plot_box.add_widget(FigureCanvasKivyAgg(fig))
        text = f"{prod_full} — {dist}{source_note}\nCurrent: {hist[-1]:.0f} MWK/kg\nIn {days} days: {pred[-1]:.0f} MWK/kg\nTrend: {('increase' if pred[-1]>hist[-1] else 'decrease' if pred[-1]<hist[-1] else 'stable').upper()}\n\nAdvice:\n" + "\n".join(advice)
        self.result_label.text = text
        self.close_popup()

    @mainthread
    def update_ui(self, text): self.result_label.text = text
    @mainthread
    def close_popup(self):
        self.predict_button.disabled = False
        if hasattr(self, 'popup') and self.popup: self.popup.dismiss()

